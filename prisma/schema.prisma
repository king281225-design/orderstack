// BhojSetu v1 schema.
// Tenant isolation rule: every query against a tenant-scoped model (Category,
// Item, Order, OrderItem, and non-super-admin User rows) MUST filter by
// tenantId. Never trust a slug or id from the client alone — always re-derive
// tenantId from the authenticated session or the public tenant lookup, and
// pass it explicitly into every query. See src/lib/data/*.ts — those are the
// only places allowed to call `prisma.category`, `prisma.item`, etc. directly;
// route/action code should go through them, not raw Prisma calls.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum FulfillmentType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum PaymentMethod {
  UPI
  COD
  // In-person card payment at the counter — manually reconciled exactly like
  // COD (no gateway involved), added for the dashboard's New Bill screen
  // only. Deliberately not offered on the storefront checkout.
  CARD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

// STOREFRONT = placed by a customer via /r/<slug>/checkout (the original
// order flow). MANUAL = created by the owner/staff directly from
// /dashboard/orders/new for a walk-in / phone-in customer — same Order
// model, same status/payment machinery, just a different entry point and
// its own printable invoice. See CLAUDE.md's billing-module note.
enum OrderSource {
  STOREFRONT
  MANUAL
}

enum SupportCategory {
  TECHNICAL_ISSUE
  ORDER_PROBLEM
  PAYMENT_BILLING
  MENU_HELP
  QR_TABLES
  ACCOUNT_LOGIN
  FEATURE_REQUEST
  GENERAL_ENQUIRY
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum ContactMethod {
  PHONE
  WHATSAPP
  EMAIL
}

enum StockMovementReason {
  PURCHASE
  ORDER
  ORDER_CANCEL
  WASTE
  ADJUSTMENT
  // Reverses a PURCHASE movement made by a bill-scan purchase that the owner
  // undid within the 10-minute window (see src/lib/data/purchases.ts
  // undoPurchase) — kept distinct from the generic ADJUSTMENT reason so the
  // ledger reads unambiguously ("this dip was an undo," not "someone
  // corrected a miscount").
  PURCHASE_UNDO
}

// "Bill Photo se Stock": an owner photographs a supplier bill, an AI vision
// model reads it, and — only after the owner confirms — the parsed lines
// become a Purchase that adds stock. See src/lib/ai/purchase-scan.ts and
// src/lib/data/purchases.ts.
enum PurchaseScanStatus {
  PROCESSING
  READY
  FAILED
}

// Live dine-in table status board (src/lib/data/tables.ts). AVAILABLE and
// RESERVED are "not currently seated"; OCCUPIED and BILLING are "seated" —
// the split exists so the board can show at a glance which occupied tables
// are ready to be paid out and closed vs. still actively ordering.
enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
}

enum PurchaseLineConfidence {
  HIGH
  MEDIUM
  LOW
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
}

// Pricing/feature copy for each tier lives in code (src/lib/plans.ts), not
// here — this just records which tier a tenant is on. Assigned manually by
// the super-admin for now: real recurring auto-billing needs both real
// Razorpay keys (pending) and a deployed public webhook URL (doesn't exist
// yet), the same two blockers already flagged for one-time payments.
enum PlanTier {
  STARTER
  ADVANCED
  BUSINESS
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

// Starter/Advanced monthly vs annual pricing (see src/lib/plans.ts). Each
// (tier, period) pair gets its own cached Razorpay Plan object — see
// RazorpayPlan below.
enum BillingPeriod {
  MONTHLY
  ANNUAL
}

model Tenant {
  id                      String             @id @default(cuid())
  slug                    String             @unique
  name                    String
  tagline                 String?
  // R2/S3 URLs (presigned or otherwise) regularly exceed MySQL's default
  // VARCHAR(191) for a String field, so these are explicitly TEXT.
  logoUrl                 String?            @db.Text
  // Five brand colors, each with a real, visible job on the storefront (see
  // src/app/r/[slug]/layout.tsx and src/components/storefront/menu-browser.tsx):
  // Primary = buttons/CTAs, Secondary = category accents/price badges/quantity
  // controls, Accent = page background tint, HeaderText = text/tagline color
  // on the primary-colored header banner, CardBackground = menu item card
  // surface. Defaults reproduce the original hardcoded look exactly (dark
  // primary, orange secondary, white everything else) so no existing
  // storefront changes appearance until its owner touches branding.
  colorPrimary            String             @default("#111827")
  colorSecondary          String             @default("#f97316")
  colorAccent             String             @default("#ffffff")
  colorHeaderText         String             @default("#ffffff")
  colorCardBackground     String             @default("#ffffff")
  isOpen                  Boolean            @default(true)
  status                  TenantStatus       @default(ACTIVE)
  // Nominal tier — either set by the super-admin's manual override, or the
  // last tier the owner actually paid for via /dashboard/billing. Does NOT
  // by itself mean the tenant is entitled to anything paid: check
  // subscriptionStatus for that. Defaults to STARTER for every new tenant
  // purely as a display fallback, not as a free grant.
  planTier                PlanTier           @default(STARTER)
  subscriptionStatus      SubscriptionStatus @default(NONE)
  razorpaySubscriptionId  String?
  // Set the moment the owner clicks Subscribe on a specific tier's card
  // (src/lib/data/tenants.ts startTenantSubscription), before any payment
  // has happened — planTier itself is only updated to match once payment is
  // actually confirmed (verifyAndActivateSubscription, or the webhook),
  // whichever fires first. Cleared back to null at that point.
  pendingPlanTier         PlanTier?
  // Monthly vs annual billing for this restaurant — what the super-admin
  // dashboard reports as "who pays monthly / annually". Set automatically
  // when a Razorpay subscription activates (from pendingBillingPeriod, stashed
  // at subscribe time exactly like pendingPlanTier), or by hand from the
  // super-admin for customers who pay outside Razorpay (bank/UPI transfer).
  // Null = not recorded; such a tenant isn't counted in revenue estimates.
  billingPeriod           BillingPeriod?
  pendingBillingPeriod    BillingPeriod?
  // End of the period the tenant has paid for. Refreshed on each Razorpay
  // activation/charge; editable by hand for manual payers. Informational —
  // nothing gates access on it (access is subscriptionStatus + the trial).
  paidUntil               DateTime?
  upiId                   String?
  // A photographed/scanned physical menu, offered as an alternative to
  // building the digital menu item-by-item (see "hardcopy menu upload" on
  // /dashboard/menu) — shown to customers as a link on the storefront.
  menuDocumentUrl         String?            @db.Text
  menuDocumentType        String? // "pdf" | "image"
  // Manual entry, shown on the storefront menu page — there's no live Google
  // Places/Business API credential, so this is the owner typing in their own
  // rating/link rather than a real-time synced widget. See CLAUDE.md.
  googleReviewUrl         String?            @db.Text
  googleRating            Float?
  googleReviewCount       Int?
  instagramUrl            String?            @db.Text
  facebookUrl             String?            @db.Text
  // Delivery radius (src/lib/geo.ts's Haversine check, run client-side via
  // the customer's browser geolocation — no geocoding API key exists or is
  // needed). latitude/longitude are the restaurant's own location, set from
  // /dashboard/branding either by the owner's own "use my current location"
  // or typed in manually. All three null = the feature is off entirely and
  // checkout behaves exactly as before.
  latitude                Float?
  longitude               Float?
  deliveryRadiusKm        Float?
  // GST/tax rate (percent, e.g. 5 for 5%) applied to manually-created bills
  // (see /dashboard/orders/new) and shown on the printed invoice. Null means
  // no tax line is added — storefront customer orders are unaffected either
  // way, this only ever feeds Order.taxCents on MANUAL-source orders.
  gstRate                 Float?
  // Shown on the printed invoice header alongside the tenant name — a
  // restaurant's registered address/GSTIN/phone, typed once in Settings.
  businessAddress         String?            @db.Text
  gstin                   String?
  // Indian state/UT the restaurant is registered in (see src/lib/india-states.ts
  // for the fixed dropdown list) — printed on the invoice as the GST "place
  // of supply", and its presence is what switches a manual bill's printed
  // invoice from a single "Tax/GST" line to a proper CGST+SGST split (see
  // Order.gstRatePercent below and invoice-view.tsx). A dine-in/walk-in
  // customer is essentially always in the same state as the restaurant, so
  // this deliberately doesn't model interstate IGST — just the correct
  // compliant presentation of the same total tax amount.
  businessState           String?
  // Set the first (and only) time this tenant redeems WELCOME100 on a ₹499
  // Starter plan purchase (see startTenantSubscription's welcomeCode param) —
  // a non-null value means "already used," independent of whether that
  // subscription is still active. This is a platform-level purchase discount,
  // deliberately separate from the tenant-scoped Coupon model above, which
  // only ever discounts a restaurant's own customer orders, never a plan
  // purchase.
  welcomeCouponRedeemedAt DateTime?
  // A restaurant's own domain pointed at this platform (see CLAUDE.md's
  // custom-domains note) — src/proxy.ts resolves an incoming Host header
  // against this to rewrite to /r/<slug>. Not meaningful until this app is
  // deployed to a public host and the owner points real DNS at it, but the
  // resolution logic itself is real and testable via the Host header alone.
  customDomain            String?            @unique
  // When true, a storefront item is automatically marked unavailable once its
  // own tracked stock hits zero (see src/lib/data/inventory.ts). Default off:
  // stock tracking never blocks or hides anything unless the owner opts in,
  // since a stale stock count shouldn't silently kill sales.
  autoHideOutOfStock      Boolean            @default(false)
  // Saved design of the printable QR cards on /dashboard/tables (brand name,
  // colours, custom lines, table labels) — validated/defaulted through
  // sanitizeQrCardDesign (src/lib/qr-card.ts) on every read and write.
  qrCardDesign            Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  users                 User[]
  categories            Category[]
  items                 Item[]
  orders                Order[]
  coupons               Coupon[]
  subscriptionPurchases SubscriptionPurchase[]
  itemAddOns            ItemAddOn[]
  waiterCalls           WaiterCall[]
  stations              Station[]
  itemStockMovements    ItemStockMovement[]
  supportTickets        SupportTicket[]
  suppliers             Supplier[]
  purchaseScans         PurchaseScan[]
  purchases             Purchase[]
  purchaseLines         PurchaseLine[]
  tables                Table[]

  @@map("tenants")
}

/**
 * A dine-in customer pressing "Call waiter" on a table's QR-linked storefront
 * (see src/components/storefront/waiter-call-button.tsx) — no order
 * required, just a table number and a timestamp. Shown to the owner/staff as
 * a badge + sound on the dashboard bell (src/components/dashboard/
 * notification-bell.tsx) until acknowledged. Deliberately a separate,
 * lightweight model rather than reusing Order — a waiter call isn't a
 * purchase and has no line items, payment, or status flow of its own.
 */
model WaiterCall {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableLabel     String
  status         WaiterCallStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  acknowledgedAt DateTime?

  @@index([tenantId, status])
  @@map("waiter_calls")
}

/**
 * Ledger of what a tenant actually paid to activate a plan — separate from
 * the recurring Razorpay subscription itself (Tenant.razorpaySubscriptionId),
 * which only ever charges a plan's standard recurring price. This exists so
 * a discounted first purchase (see WELCOME100 below) has a real, permanent
 * record of the original price, discount, coupon code, and final amount
 * paid — never recomputed or trusted from the client afterward.
 */
model SubscriptionPurchase {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier                   PlanTier
  originalPriceCents     Int
  discountCents          Int      @default(0)
  couponCode             String?
  finalPriceCents        Int
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  createdAt              DateTime @default(now())

  @@index([tenantId])
  @@map("subscription_purchases")
}

// Caches the Razorpay Plan object id created for each (PlanTier,
// BillingPeriod) pair (see src/lib/plans.ts for the prices) so subscribing a
// tenant doesn't create a duplicate Plan on Razorpay's side every time —
// created lazily on first use via getOrCreateRazorpayPlanId
// (src/lib/data/tenants.ts). period defaults to MONTHLY so the 3 rows that
// existed before annual billing was added keep their existing (tier-only)
// identity under the new composite key.
model RazorpayPlan {
  tier      PlanTier
  period    BillingPeriod @default(MONTHLY)
  planId    String
  createdAt DateTime      @default(now())

  @@id([tier, period])
  @@map("razorpay_plans")
}

model Coupon {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Stored uppercase; unique per tenant, not globally — two restaurants can
  // both run a "WELCOME10" code without colliding.
  code            String
  discountType    DiscountType
  // PERCENT: 1-100 (percent off). FIXED: cents off.
  discountValue   Int
  minOrderCents   Int          @default(0)
  // null = unlimited redemptions.
  maxRedemptions  Int?
  redemptionCount Int          @default(0)
  isActive        Boolean      @default(true)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())

  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

model User {
  id                  String               @id @default(cuid())
  tenantId            String?
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String               @unique
  passwordHash        String
  role                Role
  name                String?
  createdAt           DateTime             @default(now())
  passwordResetTokens PasswordResetToken[]
  // Single-device-login enforcement for Starter/Advanced tenants (Business
  // tenants are exempt — see src/lib/data/sessions.ts). Overwritten every
  // time this user logs in; a JWT session whose embedded `sid` no longer
  // matches this value has been superseded by a newer login elsewhere and is
  // treated as logged out (checked in src/proxy.ts). Null = never logged in,
  // or the check doesn't apply to this account's tenant.
  currentSessionId    String?

  @@index([tenantId])
  @@map("users")
}

// Forgot-password flow (src/lib/data/password-reset.ts). tokenHash stores a
// plain SHA-256 of the raw token emailed to the user — not bcrypt, since
// this is a single-use, short-lived, high-entropy random value rather than a
// user-chosen password; a fast hash is the normal, correct choice here and
// still means a leaked database doesn't hand out usable tokens directly.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  // One level of subcategory nesting (e.g. "Main Course" -> "Rice & Biryani"),
  // used by the AI menu-import wizard (/dashboard/menu/import). SetNull (not
  // Cascade) so deleting a parent category promotes its subcategories back to
  // top-level rather than risking a destructive cascade onto real menu items.
  // Only the wizard creates subcategories today — the manual "add category"
  // form still only creates top-level categories.
  parentCategoryId String?
  parent           Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subcategories    Category[] @relation("CategoryHierarchy")

  items Item[]

  @@index([tenantId])
  @@index([parentCategoryId])
  @@map("categories")
}

model Item {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  priceCents  Int
  imageUrl    String?  @db.Text
  // null = not detectable/not specified on the menu — never guessed. Set by
  // the AI menu-import wizard (or manual edit) only when the source menu
  // explicitly marks an item veg/non-veg.
  isVeg       Boolean?
  // string[] drawn only from a fixed whitelist (see ALLOWED_TAGS in
  // src/lib/ai/menu-import.ts) — enforced in application code, not by the
  // database. Null/empty = no tags.
  tags        Json?
  // { label: string; priceCents: number }[] | null — structured size/portion
  // pricing (e.g. Half/Full) captured by the AI menu-import wizard. When
  // present, priceCents above is set to the lowest variant's price so every
  // existing price-reading code path (sorting, analytics, "from ₹x") keeps
  // working unmodified; variants is the authoritative structured detail used
  // by the storefront's variant picker (see src/lib/data/orders.ts).
  variants    Json?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Kitchen station this item is routed to on KOT tickets (null = unassigned).
  stationId   String?
  station     Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  // --- Direct stock tracking — see src/lib/data/inventory.ts. Opt-in per
  // item via trackStock: BhojSetu's only stock system (the earlier separate
  // raw-material/recipe system was removed — every stocked thing is now a
  // real, sellable Item).
  sku                String?   @db.VarChar(64)
  purchasePriceCents Int?
  trackStock         Boolean   @default(false)
  stockQty           Decimal?  @db.Decimal(14, 3)
  lowStockThreshold  Decimal?  @db.Decimal(14, 3)
  lowStockAlertedAt  DateTime?
  // Other names a supplier bill might use for this product (e.g. a brand
  // name) — learned automatically the first time the owner confirms a
  // bill-scan match against this item under a different name on the bill
  // (see src/lib/data/purchases.ts), sent back to the AI extraction prompt
  // next time so matching improves without any manual setup. string[] | null.
  aliases            Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems     OrderItem[]
  addOns         ItemAddOn[]
  stockMovements ItemStockMovement[]
  purchaseLines  PurchaseLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([stationId])
  @@map("items")
}

/**
 * Append-only stock ledger for direct-stock menu Items (Item.trackStock) —
 * every stock change (a sale, a bill-scan purchase, a manual correction)
 * leaves a row here.
 */
model ItemStockMovement {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  delta     Decimal             @db.Decimal(14, 3)
  reason    StockMovementReason
  note      String?
  orderId   String?
  // Set when this movement came from a confirmed bill-scan Purchase (reason
  // PURCHASE) — lets undoPurchase find and reverse exactly this movement.
  purchaseId String?
  createdAt DateTime            @default(now())

  @@index([tenantId])
  @@index([itemId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
  @@map("item_stock_movements")
}

/**
 * Optional extras a customer can add to an item at checkout (e.g. "Extra
 * cheese +₹30") — added/removed only (no separate rename), same MVP scope
 * as everything else here. Selected add-ons are never stored as their own
 * row on the order: resolveLinePrice (src/lib/data/orders.ts) folds each
 * selected add-on's current name/price into the order line's own
 * nameSnapshot/priceCentsSnapshot at order time, the same snapshot pattern
 * already used for variants — so an order's receipt is unaffected by a
 * later add-on price change or deletion.
 */
model ItemAddOn {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([itemId])
  @@map("item_add_ons")
}

model Order {
  id                 String          @id @default(cuid())
  // MySQL requires an AUTO_INCREMENT column to be indexed (unique or
  // primary) — unlike Postgres, it can't sit on a plain non-key column.
  orderNumber        Int             @unique @default(autoincrement())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName       String
  customerPhone      String
  // Optional — only collected so an order-confirmation email can be sent
  // (see src/lib/notifications/email.ts). Phone stays the required contact.
  customerEmail      String?
  fulfillmentType    FulfillmentType
  deliveryAddress    String?         @db.Text
  // Distance from the restaurant's set location to wherever the customer's
  // browser reported at checkout (src/lib/geo.ts) — null if delivery-zone
  // checking isn't configured, or the customer's browser didn't share
  // location. Never blocks the order (soft warning only, see checkout-
  // form.tsx) — this is purely so the owner can see it on the order card
  // and use their own judgment, the same "manual reconciliation" spirit as
  // COD/UPI payment confirmation elsewhere in this schema.
  deliveryDistanceKm Float?
  // Set for DINE_IN orders placed via a table's QR link (?table=<label>) —
  // no separate Table entity; labels are just whatever the QR grid on
  // /dashboard/tables generated ("1", "2", ...), not a persisted resource.
  tableLabel         String?
  paymentMethod      PaymentMethod
  // Kitchen/fulfillment status (accept -> preparing -> ready -> completed) —
  // separate from paymentStatus below, which tracks money, not food.
  status             OrderStatus     @default(PENDING)
  // Where this order came from — see the OrderSource comment above. Feeds
  // the dashboard's "manual bill" badge and lets Customers/Analytics tell
  // the two apart without changing how either is computed.
  source             OrderSource     @default(STOREFRONT)
  // totalCents is what's actually charged (subtotal - discountCents + taxCents).
  // subtotalCents is the pre-discount, pre-tax sum of order items, kept so
  // history shows both — never recomputed from current item prices, and the
  // coupon's discount is snapshotted here too, not re-read from the coupon
  // (whose value/status can change or be deleted after the fact).
  subtotalCents      Int
  // GST/tax amount, computed server-side at order time from the tenant's
  // gstRate (see createOrder/createManualOrder) and snapshotted here for the
  // same reason discountCents is — a later change to the tenant's rate must
  // never shift a historical order's total. Zero whenever the tenant has no
  // gstRate configured — applies to storefront customer orders too (added
  // on top of the item prices at checkout, same rate as manual bills), not
  // just manually-created ones.
  taxCents           Int             @default(0)
  // The GST % actually used to compute taxCents above, snapshotted for the
  // same reason taxCents itself is (a later change to the tenant's rate must
  // never reshape a historical invoice) — null whenever taxCents is 0. Only
  // this, plus the tenant's *current* businessState, is needed to render a
  // compliant CGST+SGST split on the printed invoice (see invoice-view.tsx);
  // businessState itself isn't snapshotted since it's a display/format
  // choice, not a monetary value.
  gstRatePercent     Float?
  totalCents         Int
  couponId           String?
  coupon             Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  discountCents      Int             @default(0)
  notes              String?         @db.Text
  // COD/UPI stay PENDING until the owner manually marks them paid (see
  // markOrderPaid) — matches the plan's "reconciled manually". RAZORPAY
  // orders are moved to PAID/FAILED automatically, by the client-side
  // checkout-verification action and/or the webhook (src/lib/payments/
  // razorpay.ts), whichever fires first.
  paymentStatus      PaymentStatus   @default(PENDING)
  // Set once a Razorpay order is created for this order; unique because
  // it's a 1:1 link and the webhook looks orders up by it.
  razorpayOrderId    String?         @unique
  razorpayPaymentId  String?
  // Inventory bookkeeping (src/lib/data/inventory.ts): set the moment any
  // ordered item's own tracked stock is deducted for this order, and again
  // when a cancellation restores it — each null-to-set transition happens at
  // most once, which is what makes deduction/restore idempotent.
  stockDeductedAt    DateTime?
  stockRestoredAt    DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items OrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId             String?
  item               Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  nameSnapshot       String
  priceCentsSnapshot Int
  quantity           Int
  // KOT routing, snapshotted at order time like names/prices — a later station
  // rename/delete must not reshuffle a ticket that's already in the kitchen.
  stationId          String?
  stationName        String?

  @@index([orderId])
  @@map("order_items")
}

/**
 * A kitchen station (Grill, Tandoor, Bar, ...). Items are assigned to one; KOT
 * tickets are split/filtered by it. OrderItem snapshots the station's id and
 * name at order time (see OrderItem.stationName), so this row can be renamed
 * or deleted without touching historical tickets.
 */
model Station {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  items Item[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("stations")
}

/**
 * A help/enquiry request a restaurant sends to the BhojSetu team from the
 * dashboard Help page. Handled from /super-admin/support: the team sets the
 * status and writes a reply the restaurant sees on its Help page. The
 * screenshot, order number and user agent exist so most issues can be
 * diagnosed without a back-and-forth.
 */
model SupportTicket {
  id              String          @id @default(cuid())
  ticketNumber    Int             @unique @default(autoincrement())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByEmail  String
  contactName     String
  contactPhone    String
  contactEmail    String
  preferredContact ContactMethod  @default(PHONE)
  bestTime        String?
  category        SupportCategory
  priority        SupportPriority @default(NORMAL)
  area            String?
  orderNumber     Int?
  subject         String
  description     String          @db.Text
  screenshotUrl   String?         @db.Text
  userAgent       String?
  status          SupportStatus   @default(OPEN)
  adminResponse   String?         @db.Text
  respondedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

/** A supplier a tenant buys stock from — just a name/phone, matched loosely by name on each new bill scan (see findOrCreateSupplier). */
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  createdAt DateTime @default(now())

  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

/**
 * One "photo of a supplier bill -> AI read" attempt. imageUrls holds every
 * page (up to 3, see confirmPurchaseAction's cap). rawModelOutput is the
 * AI's raw structured response, kept for debugging/prompt-improvement (see
 * CLAUDE.md's "cost and performance" note in the original brief) — never
 * read back as authoritative; every number in it is re-validated server-side
 * (src/lib/ai/purchase-scan.ts) before it can reach a Purchase. A scan that
 * becomes a real Purchase is linked via Purchase.scanId; one that's
 * abandoned or fails just sits here as a record of the attempt.
 */
model PurchaseScan {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imageUrls      Json
  status         PurchaseScanStatus @default(PROCESSING)
  rawModelOutput Json?
  modelName      String?
  errorMessage   String?
  createdAt      DateTime           @default(now())

  purchase Purchase?

  @@index([tenantId, createdAt])
  @@map("purchase_scans")
}

/**
 * A confirmed stock purchase — created only when the owner taps "Sahi hai,
 * Save karo" on the confirm screen (see confirmPurchaseAction). Stock only
 * ever changes at that moment, never during scanning/extraction.
 * subtotalCents/grandTotalCents and every PurchaseLine's numbers are
 * recomputed server-side from the confirmed lines, never trusted from the
 * client or from the AI's raw output. undoneAt marks a purchase reversed
 * within the 10-minute undo window (src/lib/data/purchases.ts
 * undoPurchase) — the row and its lines are kept (append-only, same
 * philosophy as StockMovement/ItemStockMovement) rather than deleted.
 */
model Purchase {
  id                String        @id @default(cuid())
  // MySQL requires an AUTO_INCREMENT column to be indexed — same reason
  // Order.orderNumber and SupportTicket.ticketNumber are @unique.
  purchaseNumber    Int           @unique @default(autoincrement())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId        String?
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Copied from Supplier.name at confirm time so a purchase's printed/shown
  // supplier name never shifts if the Supplier row is later renamed — same
  // snapshot pattern Order uses for coupon/price fields.
  supplierNameSnapshot String?
  billNumber        String?
  billDate           DateTime?
  subtotalCents      Int
  extraChargesCents  Int           @default(0)
  // [{ label: string; amountCents: number }] | null — e.g. transport/loading
  // charges the bill lists separately from item lines.
  extraCharges       Json?
  grandTotalCents    Int
  scanId             String?       @unique
  scan               PurchaseScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  createdByUserId    String
  createdAt          DateTime      @default(now())
  // Set when undone within the 10-minute window — see undoPurchase. Null =
  // still in effect.
  undoneAt            DateTime?

  lines PurchaseLine[]

  @@index([tenantId, createdAt])
  @@index([tenantId, supplierId, billNumber, billDate])
  @@map("purchases")
}

/**
 * One line item from a confirmed Purchase. matchedItemId records which
 * direct-stock Product this line restocked — null means the owner chose
 * "skip this line" (nameOnBill/quantity/rate are still kept for the record,
 * but no stock movement was written for it). Only ever matches a Product
 * (Item.trackStock) — BhojSetu has no separate raw-material stock system.
 */
model PurchaseLine {
  id             String                 @id @default(cuid())
  purchaseId     String
  purchase       Purchase               @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nameOnBill     String
  matchedItemId  String?
  matchedItem    Item?                  @relation(fields: [matchedItemId], references: [id], onDelete: SetNull)
  quantity       Decimal                @db.Decimal(14, 3)
  unit           String
  rateCents      Int
  lineTotalCents Int
  confidence     PurchaseLineConfidence @default(MEDIUM)
  note           String?
  // True once the owner has touched this row on the confirm screen (edited
  // qty/rate/match) — kept for prompt-improvement analysis (which AI
  // extractions needed a human fix), no functional effect today.
  editedByUser   Boolean                @default(false)
  createdAt      DateTime               @default(now())

  @@index([purchaseId])
  @@index([tenantId])
  @@index([matchedItemId])
  @@map("purchase_lines")
}

/**
 * A real, persisted dine-in table for the live status board
 * (/dashboard/tables/board) — separate from the QR-code generator on
 * /dashboard/tables, which only ever encodes a plain label into a link
 * (/r/<slug>?table=<label>) and needs no Table row to exist. `label` is
 * meant to match whatever a table's printed QR code encodes, but nothing
 * enforces that at the database level — the QR designer and this board are
 * deliberately decoupled so neither can break the other. No FK from Order:
 * Order.tableLabel is (and stays) a free string, matched by value here, so
 * a transfer is just reassigning that string on the relevant orders rather
 * than juggling relations.
 */
model Table {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  seats     Int?
  status    TableStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("tables")
}
