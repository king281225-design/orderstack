# Copy this file to .env (local dev) and set these in Vercel's dashboard for
# production. See CLAUDE.md "Division of labor" and the MySQL/R2 migration
# note for background on this stack.

# MySQL connection string, e.g.
# mysql://user:password@host:3306/orderstack
DATABASE_URL="mysql://user:password@localhost:3306/orderstack"

# Random 32+ char secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Cloudflare R2 — object storage for menu photos and restaurant logos
# (S3-compatible; see src/lib/storage.ts). Create a bucket + API token in
# the Cloudflare dashboard (R2 > Manage API tokens).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Bootstraps the first super-admin account when you run `npm run db:seed`
# (see prisma/seed.ts). Change the password after first login.
SUPER_ADMIN_EMAIL="admin@bhojsetu.local"
SUPER_ADMIN_PASSWORD="change-me-now"

# Razorpay — "pay online" checkout option (src/lib/payments/razorpay.ts).
# Leave empty until you have keys: the checkout page just won't show the
# online-payment option, no error. Get RAZORPAY_KEY_ID/KEY_SECRET from the
# Razorpay dashboard (Settings > API Keys — test-mode keys need no KYC).
# RAZORPAY_WEBHOOK_SECRET comes from Settings > Webhooks once you add
# src/app/api/webhooks/razorpay's URL there (needs a public deployment).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email order notifications (src/lib/notifications/email.ts) — Resend.
# Leave empty until you have a key: no emails send, no error. Get one free at
# resend.com. RESEND_FROM_EMAIL needs a domain verified in the Resend
# dashboard for real delivery to arbitrary inboxes — until then it falls
# back to Resend's sandbox sender (deliverable only to your own Resend
# account email).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# AI menu import (src/lib/ai/menu-import.ts) — lets an owner upload a photo
# or PDF of their paper menu and have it read into structured
# categories/items (reviewed/edited before anything saves). Works with NO
# key set at all — a free, local, no-account OCR reader is the default and
# always available. Set this to additionally offer a more-accurate, opt-in
# "Claude AI" extraction option in the same dashboard form. Get one at
# console.anthropic.com (Settings > API Keys).
ANTHROPIC_API_KEY=""
