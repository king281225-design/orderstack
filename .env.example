# Copy this file to .env (local dev) and set these in Vercel's dashboard for
# production. See CLAUDE.md "Division of labor" and the MySQL/R2 migration
# note for background on this stack.

# MySQL connection string, e.g.
# mysql://user:password@host:3306/orderstack
DATABASE_URL="mysql://user:password@localhost:3306/orderstack"

# Random 32+ char secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Cloudflare R2 — object storage for menu photos and restaurant logos
# (S3-compatible; see src/lib/storage.ts). Create a bucket + API token in
# the Cloudflare dashboard (R2 > Manage API tokens).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Bootstraps the first super-admin account when you run `npm run db:seed`
# (see prisma/seed.ts). Change the password after first login.
SUPER_ADMIN_EMAIL="admin@orderstack.local"
SUPER_ADMIN_PASSWORD="change-me-now"
