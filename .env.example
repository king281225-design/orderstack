# Copy this file to .env (local dev) and set these in Vercel's dashboard for
# production. Real values are provisioned by whoever owns the Vercel / Neon /
# Supabase accounts — see CLAUDE.md "Division of labor".

# Postgres connection string from Neon or Supabase, e.g.
# postgresql://user:password@host/dbname?sslmode=require
#
# No Neon/Supabase project yet? `node scripts/dev-db.mjs` runs a throwaway
# local Postgres (no install, no account) — use the URL it prints, e.g.:
# postgresql://postgres:postgres@localhost:5433/orderstack
DATABASE_URL="postgresql://user:password@localhost:5432/orderstack"

# Random 32+ char secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: only needed once file uploads should hit real storage in
# production. Without it, uploads fall back to writing into /public/uploads
# locally, which works for dev but is NOT durable on Vercel's filesystem.
# Create a Blob store in the Vercel dashboard to get this token.
BLOB_READ_WRITE_TOKEN=""

# Bootstraps the first super-admin account when you run `npm run db:seed`
# (see prisma/seed.ts). Change the password after first login.
SUPER_ADMIN_EMAIL="admin@orderstack.local"
SUPER_ADMIN_PASSWORD="change-me-now"
